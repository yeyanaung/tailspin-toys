---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const selectedCategories = Astro.url.searchParams.getAll('category');
const selectedPublishers = Astro.url.searchParams.getAll('publisher');
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <form
      method="get"
      action="/"
      aria-label="Filter games"
      class="mb-8 rounded-xl border border-slate-700 bg-slate-800/80 p-5 shadow-lg"
      data-testid="games-filter-form"
    >
      <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
        <fieldset class="flex-1" data-testid="category-filter-group">
          <legend class="mb-3 text-base font-medium text-slate-200">Categories</legend>
          <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
              <label
                for={`category-${category.id}`}
                class="flex cursor-pointer items-center gap-2 rounded-full border border-slate-600 bg-slate-900/70 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500 focus-within:outline-none"
              >
                <input
                  id={`category-${category.id}`}
                  type="checkbox"
                  name="category"
                  value={category.name}
                  checked={selectedCategories.includes(category.name)}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid={`filter-category-${category.id}`}
                />
                <span>{category.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="flex-1" data-testid="publisher-filter-group">
          <legend class="mb-3 text-base font-medium text-slate-200">Publishers</legend>
          <div class="flex flex-wrap gap-3">
            {publishers.map((publisher) => (
              <label
                for={`publisher-${publisher.id}`}
                class="flex cursor-pointer items-center gap-2 rounded-full border border-slate-600 bg-slate-900/70 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-purple-500 focus-within:ring-2 focus-within:ring-purple-500 focus-within:outline-none"
              >
                <input
                  id={`publisher-${publisher.id}`}
                  type="checkbox"
                  name="publisher"
                  value={publisher.name}
                  checked={selectedPublishers.includes(publisher.name)}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-purple-500 focus:ring-2 focus:ring-purple-500 focus:outline-none"
                  data-testid={`filter-publisher-${publisher.id}`}
                />
                <span>{publisher.name}</span>
              </label>
            ))}
          </div>
        </fieldset>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-3">
        <button
          type="submit"
          class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-slate-100 transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          data-testid="apply-filters-button"
        >
          Apply filters
        </button>
        <a
          href="/"
          class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:border-slate-500 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          data-testid="clear-filters-link"
        >
          Clear filters
        </a>
      </div>
    </form>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <div data-testid="empty-games-state" hidden={games.length > 0}>
        <EmptyState text={selectedCategories.length > 0 || selectedPublishers.length > 0 ? 'No games match the selected filters.' : 'No games available at the moment.'} />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid" hidden={games.length === 0}>
        {games.map((game) => <GameCard game={game} />)}
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="games-filter-form"]');
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="empty-games-state"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

  const matchesFilters = (card: HTMLElement, selectedCategories: string[], selectedPublishers: string[]) => {
    const cardCategory = card.dataset.gameCategory || '';
    const cardPublisher = card.dataset.gamePublisher || '';
    const matchesCategory = selectedCategories.length === 0 || selectedCategories.includes(cardCategory);
    const matchesPublisher = selectedPublishers.length === 0 || selectedPublishers.includes(cardPublisher);
    return matchesCategory && matchesPublisher;
  };

  const updateFilters = () => {
    const selectedCategories = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="category"]:checked')).map((input) => input.value);
    const selectedPublishers = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="publisher"]:checked')).map((input) => input.value);
    const params = new URLSearchParams();

    selectedCategories.forEach((value) => params.append('category', value));
    selectedPublishers.forEach((value) => params.append('publisher', value));

    const nextUrl = params.toString() ? `${window.location.pathname}?${params.toString()}` : window.location.pathname;
    if (window.location.pathname + window.location.search !== nextUrl) {
      history.replaceState(null, '', nextUrl);
    }

    let visibleCount = 0;
    cards.forEach((card) => {
      const visible = matchesFilters(card, selectedCategories, selectedPublishers);
      card.hidden = !visible;
      if (visible) {
        visibleCount += 1;
      }
    });

    if (grid) {
      grid.hidden = visibleCount === 0;
    }
    if (emptyState) {
      emptyState.hidden = visibleCount > 0;
    }
  };

  if (form) {
    form.addEventListener('submit', (event: SubmitEvent) => {
      event.preventDefault();
      updateFilters();
    });

    form.addEventListener('change', () => {
      updateFilters();
    });
  }

  updateFilters();
</script>
